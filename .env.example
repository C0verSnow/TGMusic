# GitHub Secrets: only these two credentials
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# GitHub Variables
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/github-actions
INFISICAL_API_URL=https://app.infisical.com
# Enable GitHub schedule only after bootstrap is complete
TGMUSIC_ENABLED=false

# Infisical prod /github-actions (import shared values from /shared)
R2_ENDPOINT=
R2_BUCKET=tgmusic-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
PROFILE_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_DEFAULT_CHAT_ID=
BROWSER_HEADLESS=false
BROWSER_PATH=/usr/bin/google-chrome
BROWSER_USER_DATA_PATH=/tmp/youtube-sync/chrome-profile
BROWSER_INI_PATH=config/browser.ini
R2_PROFILE_OBJECT=auth/google-profile.tar.enc
YOUTUBE_PLAYLIST_ID=LM
YOUTUBE_READER=innertube
INITIAL_SYNC_MODE=baseline
SYNC_MAX_SONGS=20
SYNC_INTERVAL_MINUTES=60
AUDIO_FORMAT=mp3
AUDIO_QUALITY=best
# Comma-separated videoIds for which you have permission to download AND redistribute.
# Empty means all songs fall back to links. No wildcard is accepted.
AUDIO_AUTHORIZED_VIDEO_IDS=
MIHOMO_ENABLED=auto
MIHOMO_CONFIG_PATH=/tmp/mihomo/config.yaml
MIHOMO_CONFIG_YAML=
MIHOMO_PROXY_URL=http://127.0.0.1:7890
MIHOMO_CONTROLLER_URL=http://127.0.0.1:9090
MIHOMO_SELECT_GROUP=
MIHOMO_US_NODE=

# Infisical prod /cloudflare-worker, synced to Cloudflare Workers
# TELEGRAM_BOT_TOKEN and TELEGRAM_OWNER_ID also belong here.
TELEGRAM_WEBHOOK_SECRET=
GITHUB_WORKFLOW_TRIGGER_TOKEN=
